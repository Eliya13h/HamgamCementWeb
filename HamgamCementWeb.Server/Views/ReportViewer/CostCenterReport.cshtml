@model HamgamCementWeb.Server.Services.CostCenterReportPrintModel
@using System.Globalization
@{
    Layout = null;
    string Money(decimal value) => value.ToString("#,##0.##", CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ReportTitle</title>
    <style>
        @@font-face {
            font-family: 'NotoNastaliq';
            src: url('/report-fonts/NotoNastaliqUrdu-SemiBold.ttf') format('truetype');
            font-weight: 600;
            font-style: normal;
        }

        :root {
            --ink: #111;
            --muted: #003060;
            --line: #222;
            --soft: #f3f3f3;
            --softer: #ebebeb;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            background: #5a5a5a;
            color: var(--ink);
            font-family: Tahoma, 'Segoe UI', sans-serif;
        }

        .toolbar {
            position: sticky;
            top: 0;
            z-index: 20;
            display: flex;
            gap: 8px;
            justify-content: center;
            padding: 12px;
            background: #222;
        }

        .toolbar button {
            border: 0;
            border-radius: 8px;
            padding: 10px 18px;
            font-family: Tahoma, sans-serif;
            font-size: 14px;
            cursor: pointer;
            background: #0f766e;
            color: #fff;
        }

        .toolbar button.secondary { background: #444; }

        .sheet-wrap { padding: 20px 0 40px; }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 16px;
            padding: 8mm 8mm 10mm;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
        }

        .brand-row {
            display: grid;
            grid-template-columns: 26mm 1fr 26mm;
            gap: 4mm;
            align-items: center;
        }

        .brand-row img {
            width: 26mm;
            height: 26mm;
            object-fit: contain;
        }

        .brand-center { text-align: center; }
        .brand-fa {
            font-family: 'NotoNastaliq', Tahoma, serif;
            font-size: 18px;
            line-height: 1.5;
            margin: 0;
        }
        .brand-en {
            font-family: Georgia, 'Times New Roman', serif;
            font-style: italic;
            font-size: 14px;
            margin: 2px 0 0;
            color: #222;
        }

        .header-rule {
            height: 2px;
            margin: 3mm 0 2mm;
            background: linear-gradient(90deg, transparent, #333 12%, #333 88%, transparent);
        }

        .meta-row {
            display: grid;
            grid-template-columns: 1fr 1.4fr 1fr;
            gap: 2mm;
            align-items: end;
            font-size: 12px;
            margin-bottom: 3mm;
        }

        .meta-row .center { text-align: center; }
        .meta-row .title { font-weight: 700; font-size: 15px; margin: 0; }
        .meta-row .range { margin: 2px 0 0; font-size: 12px; }

        .filter-line { font-size: 12px; margin: 0 0 3mm; }

        h3 {
            margin: 4mm 0 2mm;
            font-size: 14px;
            color: var(--muted);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin-bottom: 4mm;
        }

        th, td {
            border: 1px solid var(--line);
            padding: 2.2mm 1.5mm;
            vertical-align: top;
        }

        th {
            background: #fff;
            color: var(--muted);
            font-weight: 700;
            text-align: center;
        }

        .num {
            text-align: left;
            font-variant-numeric: tabular-nums;
            direction: ltr;
        }

        .row-total { background: var(--softer); font-weight: 700; }
        .empty-note { text-align: center; color: #666; padding: 6mm 0; }

        @@media print {
            html, body { background: #fff; }
            .toolbar { display: none !important; }
            .sheet-wrap { padding: 0; }
            .page {
                width: 210mm;
                min-height: auto;
                margin: 0;
                box-shadow: none;
            }
            @@page { size: A4 portrait; margin: 0; }
        }
    </style>
</head>
<body>
    <div class="toolbar no-print">
        <button type="button" onclick="window.print()">چاپ / خروجی PDF</button>
        <button type="button" class="secondary" onclick="window.close()">بستن</button>
    </div>

    <div class="sheet-wrap">
        <section class="page">
            <div class="brand-row">
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyLogoDataUri))
                    {
                        <img src="@Model.CompanyLogoDataUri" alt="لوگو شرکت" />
                    }
                </div>
                <div class="brand-center">
                    <p class="brand-fa">@Model.PersianCompanyName</p>
                    <p class="brand-en">@Model.EnglishCompanyName</p>
                </div>
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.ZmLogoDataUri))
                    {
                        <img src="@Model.ZmLogoDataUri" alt="لوگو" />
                    }
                </div>
            </div>
            <div class="header-rule"></div>
            <div class="meta-row">
                <div></div>
                <div class="center">
                    <p class="title">@Model.ReportTitle</p>
                    <p class="range">@Model.ReportRangeDate</p>
                </div>
                <div style="text-align:left">تاریخ چاپ : @Model.PrintDate</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CostCenterFilterLabel) || !string.IsNullOrWhiteSpace(Model.AccountFilterLabel))
            {
                <p class="filter-line">
                    @if (!string.IsNullOrWhiteSpace(Model.CostCenterFilterLabel))
                    {
                        <span>مرکز هزینه: <strong>@Model.CostCenterFilterLabel</strong></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AccountFilterLabel))
                    {
                        <span>@(string.IsNullOrWhiteSpace(Model.CostCenterFilterLabel) ? "" : " | ")حساب: <strong>@Model.AccountFilterLabel</strong></span>
                    }
                </p>
            }

            <h3>خلاصه به تفکیک مرکز هزینه</h3>
            <table>
                <thead>
                    <tr>
                        <th style="width:14%">کد</th>
                        <th>نام</th>
                        <th style="width:16%">دیبت (Db)</th>
                        <th style="width:16%">کریدیت (Cr)</th>
                        <th style="width:16%">خالص</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Summary.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-note">در این بازه ردیفی با مرکز هزینه یافت نشد.</td></tr>
                    }
                    else
                    {
                        foreach (var row in Model.Summary)
                        {
                            <tr>
                                <td class="num">@row.Code</td>
                                <td>@row.Name</td>
                                <td class="num">@Money(row.Debit)</td>
                                <td class="num">@Money(row.Credit)</td>
                                <td class="num">@Money(row.Net)</td>
                            </tr>
                        }
                        <tr class="row-total">
                            <td colspan="2">جمع</td>
                            <td class="num">@Money(Model.TotalDebit)</td>
                            <td class="num">@Money(Model.TotalCredit)</td>
                            <td class="num">@Money(Model.TotalNet)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>جزئیات خطوط</h3>
            <table>
                <thead>
                    <tr>
                        <th style="width:11%">تاریخ</th>
                        <th style="width:11%">شماره سند</th>
                        <th style="width:18%">حساب</th>
                        <th style="width:16%">مرکز هزینه</th>
                        <th>شرح</th>
                        <th style="width:11%">دیبت (Db)</th>
                        <th style="width:11%">کریدیت (Cr)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Details.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-note">جزئیاتی برای نمایش وجود ندارد.</td></tr>
                    }
                    else
                    {
                        foreach (var row in Model.Details)
                        {
                            <tr>
                                <td>@row.ShamsiDate</td>
                                <td class="num">@row.EntryNumber</td>
                                <td>@row.AccountLabel</td>
                                <td>@row.CostCenterLabel</td>
                                <td>@row.Description</td>
                                <td class="num">@(row.Debit == 0 ? "" : Money(row.Debit))</td>
                                <td class="num">@(row.Credit == 0 ? "" : Money(row.Credit))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    </div>
</body>
</html>
