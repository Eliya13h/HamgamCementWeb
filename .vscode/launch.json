    {
      "name": "Transport (Server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-transport",
      "program": "${workspaceFolder}/HamgamTransport.Server/bin/Debug/net9.0/HamgamTransport.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/HamgamTransport.Server",
      "stopAtEntry": false,
      "launchSettingsProfile": "https"
    }
  ],
  "compounds": [
    {
      "name": "Both: Cement + Transport",
      "configurations": ["Cement (Server)", "Transport (Server)"],
      "stopAll": true
