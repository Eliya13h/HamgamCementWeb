{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cement (Server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cement",
      "program": "${workspaceFolder}/HamgamCementWeb.Server/bin/Debug/net9.0/HamgamCementWeb.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/HamgamCementWeb.Server",
      "stopAtEntry": false,
      "launchSettingsProfile": "https"
